<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- תוקן: העתקת קבצי ה-JSON לתיקיית ההרצה, אחרת File.ReadAllText לא ימצא אותם -->
  <ItemGroup>
    <None Update="HtmlTags.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="HtmlVoidTags.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
